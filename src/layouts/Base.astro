---
// Page shell (SPEC Stage 1 task 7): head stub, theme init, skip link, header, main, footer.
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { NavId } from '../site.config';

interface Props {
  title: string;
  description: string;
  current?: NavId | undefined;
  noindex?: boolean;
  /** Absolute canonical URL; defaults to this page's own URL (posts pass the D6 result). */
  canonical?: string | undefined;
}

const { title, description, current, noindex = false, canonical } = Astro.props;
const canonicalHref = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalHref} />
    <link rel="preload" href="/fonts/geist-mono-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Light is the default; apply a stored dark choice before first paint (SPEC Q1, D9a). -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
    <noscript><style>.theme-toggle{display:none}</style></noscript>
    <slot name="head" />
  </head>
  <!-- id="top": the footer's back-to-top target. It can't be the sticky header, which is always
       on screen, so jumping to it never scrolls. -->
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
