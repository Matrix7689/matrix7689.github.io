---
// Eyebrow badge with a 6px square (SPEC §5, DesignSpec §1.4 Badge).
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span class="badge">{label}</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: var(--hairline) solid var(--border);
    font-size: var(--fs-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
  }

  .badge::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--fg);
  }
</style>
