---
// Featured latest post (SPEC §5 FeaturedPost, §4.3): the PostListItem fields plus reading time,
// with a larger title.
import PostListItem from './PostListItem.astro';

interface Props {
  date: Date;
  tags: string[];
  title: string;
  summary: string;
  href: string;
  medium?: boolean;
  readingTime: number;
  level?: 2 | 3;
}

const { readingTime, ...item } = Astro.props;
---

<div class="featured">
  <p class="label">Latest · {readingTime} min read</p>
  <PostListItem {...item} featured maxTags={3} />
</div>

<style>
  .featured {
    display: grid;
    gap: var(--space-2);
    padding-bottom: var(--space-8);
    border-bottom: var(--hairline) solid var(--border);
  }
</style>
