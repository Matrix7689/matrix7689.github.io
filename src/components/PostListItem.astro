---
// Blog list entry (SPEC §5 PostListItem, §4.3): `YYYY-MM-DD  [tag]  Title` / TL;DR, optionally with a
// reading time, a [medium] marker and a cover thumbnail on the left (grayscale, colour on hover/focus).
// The title link covers the whole row; hover underlines the title and tints the row.
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import { isoDate } from '../lib/dates';

interface Props {
  date: Date;
  tags: string[];
  title: string;
  summary: string;
  href: string;
  medium?: boolean;
  featured?: boolean;
  /** How many tags to show (the first ones). */
  maxTags?: number;
  /** Heading level for the title: 2 when the list sits directly under the page's h1. */
  level?: 2 | 3;
  /** Minutes to read, shown after the tags. */
  readingTime?: number | undefined;
  /** Cover photo, shown as a small thumbnail on the left. */
  thumb?: ImageMetadata | undefined;
}

const { date, tags, title, summary, href, medium = false, featured = false, maxTags = 1, level = 3, readingTime, thumb } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class:list={['post', { 'post--featured': featured, 'post--thumb': thumb }]}>
  {thumb && <Img src={thumb} alt="" preset="thumb" maxWidth={400} sizes="(min-width: 48rem) 10rem, 6rem" grayscale class="post__thumb" />}
  <div class="post__body">
    <p class="post__meta">
      <time datetime={isoDate(date)}>{isoDate(date)}</time>
      {tags.slice(0, maxTags).map((t) => <span>[{t}]</span>)}
      {readingTime !== undefined && <span>{readingTime} min read</span>}
      {
        medium && (
          <span class="post__medium">
            [medium]<span class="visually-hidden"> also published on Medium</span>
          </span>
        )
      }
    </p>
    <Heading class="post__title"><a href={href}>{title}</a></Heading>
    <p class="post__summary">{summary}</p>
  </div>
</article>

<style>
  .post {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
  }

  .post--thumb {
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .post--thumb {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  .post__body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  /* Covers vary in shape, so thumbnails share one frame. */
  .post :global(.post__thumb) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: var(--hairline) solid var(--border);
  }

  /* Colour returns while the row is hovered or its link is focused. */
  .post:hover :global(.img-gray),
  .post:focus-within :global(.img-gray) {
    filter: none;
  }

  .post:hover {
    background: var(--card);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  .post__medium {
    color: var(--fg);
  }

  .post__title {
    font-size: var(--fs-body);
    font-weight: 700;
  }

  .post--featured .post__title {
    font-size: var(--fs-title);
  }

  .post__title a {
    text-decoration: none;
  }

  /* Stretched link: the whole row is the hit target. */
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post:hover .post__title a,
  .post__title a:focus-visible {
    text-decoration-line: underline;
  }

  .post__summary {
    max-width: var(--prose);
    color: var(--muted);
  }
</style>
