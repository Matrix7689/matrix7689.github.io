---
// Blog list entry (SPEC §5 PostListItem, §4.3): `YYYY-MM-DD  [tag]  Title` / TL;DR / [medium].
// The title link covers the whole row; hover underlines the title and tints the row.
import { isoDate } from '../lib/dates';

interface Props {
  date: Date;
  tags: string[];
  title: string;
  summary: string;
  href: string;
  medium?: boolean;
  featured?: boolean;
  /** How many tags to show (the first ones). */
  maxTags?: number;
  /** Heading level for the title: 2 when the list sits directly under the page's h1. */
  level?: 2 | 3;
}

const { date, tags, title, summary, href, medium = false, featured = false, maxTags = 1, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class:list={['post', { 'post--featured': featured }]}>
  <p class="post__meta">
    <time datetime={isoDate(date)}>{isoDate(date)}</time>
    {tags.slice(0, maxTags).map((t) => <span>[{t}]</span>)}
    {
      medium && (
        <span class="post__medium">
          [medium]<span class="visually-hidden"> also published on Medium</span>
        </span>
      )
    }
  </p>
  <Heading class="post__title"><a href={href}>{title}</a></Heading>
  <p class="post__summary">{summary}</p>
</article>

<style>
  .post {
    position: relative;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
  }

  .post:hover {
    background: var(--card);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  .post__medium {
    color: var(--fg);
  }

  .post__title {
    font-size: var(--fs-body);
    font-weight: 700;
  }

  .post--featured .post__title {
    font-size: var(--fs-title);
  }

  .post__title a {
    text-decoration: none;
  }

  /* Stretched link: the whole row is the hit target. */
  .post__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post:hover .post__title a,
  .post__title a:focus-visible {
    text-decoration-line: underline;
  }

  .post__summary {
    max-width: var(--prose);
    color: var(--muted);
  }
</style>
