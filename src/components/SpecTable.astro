---
// Label/value facts table (SPEC §5, DesignSpec §1.4 Spec table). size="lg" uses body text and more spacing.
// A row value is plain text, one link (href) or several links (links, e.g. a map's platforms).
interface Row {
  label: string;
  value: string;
  href?: string | undefined;
  links?: { label: string; href: string }[] | undefined;
}

interface Props {
  label: string;
  rows: Row[];
  size?: 'sm' | 'lg';
}

const { label, rows, size = 'sm' } = Astro.props;
---

<div class:list={['spec', `spec--${size}`]}>
  <p class="spec__head label"><span class="sq" aria-hidden="true"></span>{label}</p>
  <dl>
    {
      rows.map((row) => (
        <div class="spec__row">
          <dt>{row.label}</dt>
          <dd>
            {row.links ? (
              row.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href}>{l.label}</a>
                </>
              ))
            ) : row.href ? (
              <a href={row.href}>{row.value}</a>
            ) : (
              row.value
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .spec {
    border: var(--hairline) solid var(--border);
  }

  .spec__head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--hairline) solid var(--border);
  }

  .sq {
    width: 6px;
    height: 6px;
    background: var(--fg);
  }

  .spec__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.625rem var(--space-4);
    font-size: var(--fs-ui);
  }

  .spec__row + .spec__row {
    border-top: var(--hairline) solid var(--border);
  }

  .spec__row:hover {
    background: var(--card);
  }

  /* Large rows read as a two-column list: a fixed label column, values left-aligned beside it. */
  .spec--lg .spec__row {
    display: grid;
    grid-template-columns: 12rem 1fr;
    padding: var(--space-4) var(--space-6);
    font-size: var(--fs-body-lg);
  }

  .spec--lg dd {
    text-align: left;
  }

  dt {
    flex: none;
    color: var(--muted);
  }

  /* Long values (skill lists) stack under their label on narrow screens. */
  @media (max-width: 47.99rem) {
    .spec--lg .spec__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding: var(--space-3) var(--space-4);
    }
  }

  dd {
    text-align: right;
  }

  dd a {
    text-decoration-line: underline;
  }
</style>
