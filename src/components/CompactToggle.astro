---
// Compact-mode switch for a section (Jay, Stage 5 checkpoint). CSS only, no JS: a native checkbox
// (role="switch", checked = compact by default). The checkbox is rendered as a sibling placed *before* the
// section's content, so `.compact-input:checked ~ * .is-extra` (base.css) hides the extra content with a
// plain sibling selector that every browser supports; no :has(). Place it directly inside the same parent as
// the content it compacts. Everything is in the HTML either way. A browser may restore a visitor's own
// toggle on reload.
interface Props {
  /** Unique id for the checkbox. */
  id: string;
  /** What the switch compacts, for the accessible name, e.g. "experience". */
  label: string;
}

const { id, label } = Astro.props;
---

<input class="compact-input" type="checkbox" role="switch" id={id} checked aria-label={`Compact ${label}`} />
<div class="section-tools">
  <label class="switch" for={id}>
    <span class="switch__box" aria-hidden="true"></span>
    <span class="switch__text" aria-hidden="true">compact</span>
  </label>
</div>

<style>
  /* Visually hidden but still focusable; the label below draws the state and takes the clicks. */
  .compact-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    opacity: 0;
  }

  .section-tools {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-6);
  }

  .switch {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border: var(--hairline) solid var(--border);
    font-size: var(--fs-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
    cursor: pointer;
    user-select: none;
  }

  .switch:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .compact-input:focus-visible + .section-tools .switch {
    outline: var(--ring-width) solid var(--ring);
    outline-offset: 2px;
  }

  .switch__box::before {
    content: '[ ]';
  }

  .compact-input:checked + .section-tools .switch {
    color: var(--fg);
  }

  .compact-input:checked + .section-tools .switch__box::before {
    content: '[x]';
  }
</style>
