---
// Responsive image (SPEC Stage 2 task 2, §5 Img): <picture> with AVIF, WebP and a JPEG fallback,
// explicit width/height, lazy + async by default. For "view original" links use largeUrl() from lib/images.
// data-preset lets check-budgets cap each output by preset.
import type { ImageMetadata } from 'astro';
import { PRESETS, heightFor, srcsetFor, widthsFor, type Preset } from '../lib/images';

interface Props {
  src: ImageMetadata;
  alt: string;
  preset: Preset;
  /** The `sizes` attribute, from the layout that places the image. */
  sizes: string;
  /** Only for the first image above the fold. */
  eager?: boolean;
  /** Grayscale until the enclosing link is hovered or focused (CSS filter, see base.css). */
  grayscale?: boolean;
  class?: string;
}

const { src, alt, preset, sizes, eager = false, grayscale = false, class: className } = Astro.props;
const spec = PRESETS[preset];
const widths = widthsFor(src, spec.widths);
const sets = await Promise.all(spec.formats.map(({ format, quality }) => srcsetFor(src, widths, format, quality)));
const toSrcset = (set: { url: string; width: number }[]) => set.map((s) => `${s.url} ${s.width}w`).join(', ');
const fallback = sets.at(-1)!;
const width = widths.at(-1)!;
---

<picture data-preset={preset}>
  {
    spec.formats.slice(0, -1).map(({ format }, i) => (
      <source type={`image/${format}`} srcset={toSrcset(sets[i]!)} sizes={sizes} />
    ))
  }
  <img
    src={fallback.at(-1)!.url}
    srcset={toSrcset(fallback)}
    sizes={sizes}
    alt={alt}
    width={width}
    height={heightFor(src, width)}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    data-eager={eager ? '' : undefined}
    class:list={[className, { 'img-gray': grayscale }]}
  />
</picture>
