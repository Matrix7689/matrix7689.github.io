---
// Tag filter row (SPEC §5 TagFilter, D7): `all` + every tag, each a link to a static tag page,
// so filtering needs no JS. The active tag is inverted and has aria-current.
import Tag from './Tag.astro';

interface Props {
  tags: string[];
  /** The active tag, or null for `all`. */
  active: string | null;
}

const { tags, active } = Astro.props;
---

<nav aria-label="Filter posts by tag">
  <ul class="tags" role="list">
    <li><Tag label="all" href="/blog/" active={active === null} /></li>
    {
      tags.map((t) => (
        <li>
          <Tag label={t} href={`/blog/tags/${t}/`} active={active === t} />
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
