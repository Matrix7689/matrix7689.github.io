---
// Grid of ThumbCards (SPEC §5 ThumbGrid): 2 columns from 360 px, 3 from 768 px, 4 from 1200 px.
// size="sm" (the archive's other maps): 3 / 4 / 6 columns. Both sizes serve the 400 px thumbnail only
// (Jay, Stage 7 checkpoint), which keeps the archive with 41 thumbnails inside its 450 KB total budget.
import type { ImageMetadata } from 'astro';
import ThumbCard from './ThumbCard.astro';

interface Item {
  title: string;
  year?: number | undefined;
  href: string;
  image: ImageMetadata;
}

interface Props {
  items: Item[];
  /** Accessible name for the list, e.g. "Maps". */
  label: string;
  size?: 'md' | 'sm';
}

const { items, label, size = 'md' } = Astro.props;
// Column widths match the breakpoints below, within the 80rem container.
const SIZES = size === 'sm' ? '(min-width: 75rem) 12rem, (min-width: 48rem) 23vw, 31vw' : '(min-width: 75rem) 18rem, (min-width: 48rem) 31vw, 46vw';
const maxWidth = 400;
---

<ul class:list={['grid', `grid--${size}`]} role="list" aria-label={label}>
  {
    items.map((item) => (
      <li>
        <ThumbCard {...item} sizes={SIZES} maxWidth={maxWidth} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 75rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .grid--sm {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  @media (min-width: 48rem) {
    .grid--sm {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }

  @media (min-width: 75rem) {
    .grid--sm {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
