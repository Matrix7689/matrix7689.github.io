---
// Grid of ThumbCards (SPEC §5 ThumbGrid): 2 columns from 360 px, 3 from 768 px, 4 from 1200 px.
import type { ImageMetadata } from 'astro';
import ThumbCard from './ThumbCard.astro';

interface Item {
  title: string;
  year?: number | undefined;
  href: string;
  image: ImageMetadata;
}

interface Props {
  items: Item[];
  /** Accessible name for the list, e.g. "Maps". */
  label: string;
}

const { items, label } = Astro.props;
// Column widths match the breakpoints below, within the 80rem container.
const SIZES = '(min-width: 75rem) 18rem, (min-width: 48rem) 31vw, 46vw';
---

<ul class="grid" role="list" aria-label={label}>
  {
    items.map((item) => (
      <li>
        <ThumbCard {...item} sizes={SIZES} />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  @media (min-width: 75rem) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
