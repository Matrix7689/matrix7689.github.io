---
// Post list shared by /blog/ and tag pages (SPEC §4.3): PostListItem rows with h2 titles.
import PostListItem from './PostListItem.astro';
import { postSlug, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<div class="list">
  {
    posts.map((p) => (
      <PostListItem
        date={p.data.date}
        tags={p.data.tags}
        title={p.data.title}
        summary={p.data.summary}
        href={`/blog/${postSlug(p)}/`}
        medium={p.data.mediumUrl !== undefined}
        level={2}
      />
    ))
  }
</div>

<style>
  .list {
    display: grid;
    gap: var(--space-2);
  }
</style>
