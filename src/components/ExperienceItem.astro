---
// One role (SPEC §5 ExperienceItem, §4.2). Left column, largest to smallest (Jay, Stage 5 checkpoint):
// title, company as a Badge, then dates and location as Tags; [*] bullets on the right.
// `limit` shows the first N bullets; omit it to show all. `compact` lists the 1-based bullets kept in
// compact mode: the others render with `is-extra`, which a preceding CompactToggle hides.
import Badge from './Badge.astro';
import Tag from './Tag.astro';
import { inlineMarkdown } from '../lib/inline';
import { roleRange } from '../lib/dates';

interface Props {
  company: string;
  title: string;
  start: string;
  end?: string | undefined;
  location: string;
  bullets: string[];
  limit?: number | undefined;
  compact?: number[] | undefined;
}

const { company, title, start, end, location, bullets, limit, compact } = Astro.props;
const shown = limit ? bullets.slice(0, limit) : bullets;
const isExtra = (i: number) => compact !== undefined && !compact.includes(i + 1);
// A list left with nothing to show in compact mode is extra too, so it collapses with its bullets.
const allExtra = shown.every((_, i) => isExtra(i));
---

<article class="role">
  <header class="role__head">
    <h3>{title}</h3>
    <p class="role__company"><Badge label={company} /></p>
    <ul class="role__tags" role="list">
      {[roleRange(start, end), location].map((t) => <li><Tag label={t} /></li>)}
    </ul>
  </header>
  <ul class:list={['role__bullets', { 'is-extra': allExtra }]} role="list">
    {
      shown.map((b, i) => (
        <li class:list={{ 'is-extra': isExtra(i) }}>
          <span set:html={inlineMarkdown(b)} />
        </li>
      ))
    }
  </ul>
</article>

<style>
  .role {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 64rem) {
    .role {
      grid-template-columns: minmax(16rem, 1fr) 2fr;
      gap: var(--space-8);
    }
  }

  .role__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  h3 {
    font-size: var(--fs-title);
    font-weight: 700;
    color: var(--fg);
  }

  .role__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .role__bullets {
    display: grid;
    gap: var(--space-3);
    max-width: var(--prose);
  }

  .role__bullets > li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
  }

  /* [*] marker (DesignSpec §2.1); the "/ ''" alt text keeps it out of the accessibility tree. */
  .role__bullets > li::before {
    content: '[*]' / '';
    color: var(--muted);
  }
</style>
