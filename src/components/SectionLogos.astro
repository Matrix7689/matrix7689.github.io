---
// Monochrome logos beside an About-page heading (Jay, Stage 8 checkpoint). SVGs come from
// src/assets/logos/<name>.svg and are inlined (no extra request, no third-party host), recoloured with
// currentColor so they follow the theme. Names with no file yet are skipped, so a logo Jay adds later
// (e.g. hammer.svg) just appears. Decorative: the heading and text already name what they show.
// amazon.svg, counterstrike.svg: Simple Icons 13.21.0 (CC0), downloaded with Jay's OK.
interface Props {
  names: string[];
}

const files = import.meta.glob<string>('../assets/logos/*.svg', { query: '?raw', import: 'default', eager: true });
const byName = new Map(Object.entries(files).map(([path, svg]) => [path.split('/').pop()!.replace(/\.svg$/, ''), svg]));

// Drop the file's own title and role, then make it a decorative, theme-coloured inline icon.
const clean = (svg: string) =>
  svg
    .replace(/<title>[\s\S]*?<\/title>/g, '')
    .replace(/\s(role|width|height|fill)="[^"]*"/g, '')
    .replace('<svg', '<svg fill="currentColor" aria-hidden="true" focusable="false" class="logo__svg"');

const logos = Astro.props.names.filter((n) => byName.has(n)).map((n) => ({ name: n, svg: clean(byName.get(n)!) }));
---

{
  logos.length > 0 && (
    <span class="logos">
      {logos.map((l) => (
        <span class="logo" set:html={l.svg} />
      ))}
    </span>
  )
}

<style>
  .logos {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo {
    display: inline-flex;
    color: var(--muted);
  }

  .logo :global(.logo__svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
