---
// Previous / next links (SPEC §5 PrevNext): posts by date, projects by order. A missing side is not rendered.
interface Link {
  title: string;
  href: string;
}
interface Props {
  prev?: Link | undefined;
  next?: Link | undefined;
  /** Landmark name and side labels; defaults are for blog posts. */
  label?: string;
  prevLabel?: string;
  nextLabel?: string;
}

const { prev, next, label = 'More posts', prevLabel = '← older', nextLabel = 'newer →' } = Astro.props;
---

{
  (prev || next) && (
    <nav class="prevnext" aria-label={label}>
      {prev && (
        <a class="prev" href={prev.href}>
          <span class="label">{prevLabel}</span>
          <span class="t">{prev.title}</span>
        </a>
      )}
      {next && (
        <a class="next" href={next.href}>
          <span class="label">{nextLabel}</span>
          <span class="t">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .prevnext {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 48rem) {
    .prevnext {
      grid-template-columns: 1fr 1fr;
    }

    .next {
      grid-column: 2;
      text-align: right;
    }
  }

  a {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--hairline) solid var(--border);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    border-color: var(--fg);
  }

  .t {
    font-weight: 700;
  }
</style>
