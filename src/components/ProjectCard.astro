---
// Project card (SPEC §5 ProjectCard): text first, optional tiny grayscale thumbnail.
// Hover/focus: border → fg, thumbnail → colour. The title link covers the whole card; optional outbound
//  (e.g. GitHub, live demo, on /projects/) sit above that overlay so they stay clickable.
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  summary: string;
  stack: string[];
  year?: number | undefined;
  href: string;
  thumb?: ImageMetadata | undefined;
  links?: { label: string; href: string }[];
}

const { title, summary, stack, year, href, thumb, links = [] } = Astro.props;
---

<article class:list={['card', { 'card--thumb': thumb }]}>
  <div class="card__text">
    <h3><a href={href}>{title}</a></h3>
    <p class="card__summary">{summary}</p>
    <ul class="card__stack" role="list" aria-label="Stack">
      {
        stack.map((s) => (
          <li>
            <Tag label={s} />
          </li>
        ))
      }
    </ul>
    {year && <p class="card__year">{year}</p>}
    {
      links.length > 0 && (
        <ul class="card__links" role="list" aria-label={`${title} links`}>
          {links.map((l) => (
            <li>
              <a href={l.href}>
                {l.label} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  {thumb && <Img src={thumb} alt="" preset="thumb" sizes="(min-width: 48rem) 160px, 96px" grayscale class="card__thumb" />}
</article>

<style>
  .card {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: var(--hairline) solid var(--border);
  }

  .card--thumb {
    grid-template-columns: 1fr 6rem;
  }

  @media (min-width: 48rem) {
    .card--thumb {
      grid-template-columns: 1fr 10rem;
    }
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--fg);
  }

  .card__text {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  h3 {
    font-size: var(--fs-body);
    font-weight: 700;
  }

  h3 a {
    text-decoration: none;
  }

  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h3 a,
  h3 a:focus-visible {
    text-decoration-line: underline;
  }

  .card__summary {
    color: var(--muted);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card__year {
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  .card__links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--fs-ui);
  }

  .card__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 1.5rem;
    text-decoration-line: underline;
  }

  .card :global(.card__thumb) {
    border: var(--hairline) solid var(--border);
  }

  /* The thumbnail regains colour while the card is hovered or its link is focused. */
  .card:hover :global(.img-gray),
  .card:focus-within :global(.img-gray) {
    filter: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition: border-color var(--duration);
    }
  }
</style>
