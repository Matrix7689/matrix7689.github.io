---
// Copyable command in a terminal card (SPEC §5, DesignSpec §2.1, §4 Terminal motifs).
// Without JS the command is plain selectable text and the copy button stays hidden.
import TerminalCard from './TerminalCard.astro';

interface Props {
  command: string;
  title?: string;
  outputLinks?: { label: string; href: string }[];
  cursor?: boolean;
  id: string;
  /** Title bar style, passed to TerminalCard. */
  variant?: 'default' | 'inverted';
}

const { command, title = 'terminal', outputLinks = [], cursor = true, id, variant = 'default' } = Astro.props;
---

<TerminalCard title={title} variant={variant}>
  <div class="cmd">
    <p class="cmd__line"><span class="muted" aria-hidden="true">$ </span><code id={id}>{command}</code></p>
    <button type="button" class="cmd__copy" data-copy-target={id} aria-label="Copy command" hidden>copy</button>
    <span class="visually-hidden" aria-live="polite"></span>
  </div>
  {
    outputLinks.length > 0 && (
      <ul class="cmd__out" role="list">
        {outputLinks.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    )
  }
  {
    cursor && (
      <p class="cmd__cursor" aria-hidden="true">
        $ <span class="cursor">█</span>
      </p>
    )
  }
</TerminalCard>

<script>
  // Copy button behaviour (SPEC D9b), shared with blog code blocks.
  import '../scripts/copy.ts';
</script>

<style>
  .cmd {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .cmd__line {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .cmd__copy {
    flex: none;
    min-height: 1.5rem;
    min-width: 3.5rem;
    padding: 0 var(--space-2);
    border: var(--hairline) solid var(--border);
    font-size: var(--fs-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
  }

  .cmd__copy:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .cmd__out {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin-top: var(--space-2);
  }

  .cmd__out a {
    color: var(--muted);
  }

  .cmd__out a:hover,
  .cmd__out a:focus-visible {
    color: var(--fg);
  }

  .cmd__cursor {
    margin-top: var(--space-2);
  }
</style>
