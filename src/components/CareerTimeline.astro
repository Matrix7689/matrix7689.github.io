---
// Horizontal career timeline (Jay, Stage 5 follow-up), a static port of the template's "Thread Profiler"
// (section 07, Concurrency Models): one lane per organisation, bars placed by month along a year scale.
// No JS and no motion. Geometry comes from lib/timeline.ts; the page puts its `css` (bar positions) in
// <head>. Each bar is focusable and opens a card like the nav's loadTime card on hover or focus; the card
// text is always in the DOM, so screen readers read it.
import type { Timeline } from '../lib/timeline';

interface Props {
  timeline: Timeline;
}

const { firstYear, years, rows } = Astro.props.timeline;
---

<figure class="tl" aria-labelledby="tl-title">
  <div class="tl__head">
    <p class="tl__name" id="tl-title"><span class="tl__dot" aria-hidden="true"></span>Career profiler</p>
    <p>{firstYear} — present</p>
  </div>

  <div class="tl__row tl__scale" aria-hidden="true">
    <span class="tl__label"></span>
    <svg class="tl__svg" width="100%" height="28" focusable="false">
      {years.map((y) => <text class:list={{ tl__odd: y.odd }} x={y.x} y="18">{y.year}</text>)}
    </svg>
  </div>

  <ul class="tl__lanes" role="list">
    {
      rows.map((lane) => (
        <li class="tl__row">
          <span class="tl__label">
            <span class:list={['tl__sq', { 'tl__sq--muted': lane.studyOnly }]} aria-hidden="true"></span>
            {lane.label}
          </span>
          <div class="tl__track">
            <svg class="tl__svg" width="100%" height="100%" aria-hidden="true" focusable="false">
              <rect class="tl__lane" width="100%" height="100%" />
              {years.map((y) => <line class="tl__tick" x1={y.x} x2={y.x} y1="0" y2="100%" />)}
            </svg>
            <ul role="list">
              {lane.bars.map((b) => (
                <li class:list={['tl__seg', `tl__seg--${b.kind}`, b.cls, { 'tl__seg--flip': b.flip }]} tabindex="0">
                  <span class="tl__card">
                    <span>
                      {'role  = '}<span class="tl__v">{b.title}</span>
                    </span>
                    <span>
                      {'org   = '}<span class="tl__v">{b.org}</span>
                    </span>
                    <span>
                      {'time  = '}<span class="tl__v">{b.time}</span>
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>

  <figcaption class="tl__legend">
    <span><span class="tl__key tl__seg--work" aria-hidden="true"></span>Work</span>
    <span><span class="tl__key tl__seg--internship" aria-hidden="true"></span>Internship</span>
    <span><span class="tl__key tl__seg--study" aria-hidden="true"></span>Study</span>
  </figcaption>
</figure>

<style>
  .tl {
    margin-bottom: var(--space-12);
    border: var(--hairline) solid var(--border);
    font-size: var(--fs-micro);
    color: var(--muted);
  }

  .tl__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-bottom: var(--hairline) solid var(--border);
  }

  .tl__name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }

  .tl__dot {
    width: 8px;
    height: 8px;
    background: var(--fg);
  }

  .tl__row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: center;
    padding-inline: var(--space-4);
    border-bottom: var(--hairline) solid var(--border);
  }

  @media (min-width: 48rem) {
    .tl__row {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  .tl__lanes > .tl__row:last-child {
    border-bottom: 0;
  }

  .tl__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    font-size: var(--fs-ui);
  }

  .tl__sq {
    width: 6px;
    height: 6px;
    flex: none;
    background: var(--fg);
  }

  .tl__sq--muted {
    background: var(--muted);
  }

  /* overflow visible: the last year label may run just past the track's right edge. */
  .tl__svg {
    display: block;
    overflow: visible;
  }

  /* Explicit heights: base.css sets svg { height: auto }, which would make these 150 px tall. */
  .tl__scale .tl__svg {
    height: 1.75rem;
  }

  .tl__track .tl__svg {
    height: 100%;
  }

  .tl__svg text {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    fill: var(--muted);
  }

  /* Every other year on narrow screens, where twelve labels don't fit. */
  @media (max-width: 47.99rem) {
    .tl__odd {
      display: none;
    }
  }

  .tl__track {
    position: relative;
    height: 1rem;
  }

  .tl__lane {
    fill: color-mix(in srgb, var(--border) 30%, transparent);
  }

  .tl__tick {
    stroke: var(--border);
    stroke-width: 1;
  }

  /* Bars: left/width come from the page's generated .tl-bN rules. */
  .tl__seg {
    position: absolute;
    top: 0;
    bottom: 0;
    /* A background-coloured edge keeps back-to-back roles apart (SDE I → SDE II). */
    box-shadow: -2px 0 0 var(--bg);
    cursor: default;
  }

  .tl__seg--work {
    background: var(--fg);
  }

  .tl__seg--internship {
    background: var(--muted);
  }

  .tl__seg--study {
    background: color-mix(in srgb, var(--fg) 32%, transparent);
  }

  .tl__seg:hover,
  .tl__seg:focus-visible {
    z-index: 2;
    outline: var(--ring-width) solid var(--ring);
    outline-offset: 2px;
  }

  /* The card (same look as the nav's loadTime card): visually hidden until hover or focus. */
  .tl__card {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    display: grid;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: pre;
  }

  .tl__seg--flip .tl__card {
    right: 0;
    left: auto;
  }

  .tl__seg:hover .tl__card,
  .tl__seg:focus-visible .tl__card {
    width: auto;
    height: auto;
    padding: var(--space-2) var(--space-3);
    clip: auto;
    border: var(--hairline) solid var(--fg);
    background: var(--bg);
    color: var(--muted);
    font-size: var(--fs-ui);
    line-height: 1.6;
  }

  /* Narrow screens: a bar's card can be wider than the screen, so it docks to the bottom of the viewport
     and wraps. :focus (not only :focus-visible) so a tap opens it too. */
  @media (max-width: 47.99rem) {
    .tl__seg:focus .tl__card,
    .tl__seg:hover .tl__card {
      position: fixed;
      inset: auto var(--gutter) var(--gutter);
      z-index: 20;
      width: auto;
      height: auto;
      padding: var(--space-2) var(--space-3);
      clip: auto;
      border: var(--hairline) solid var(--fg);
      background: var(--bg);
      color: var(--muted);
      font-size: var(--fs-ui);
      line-height: 1.6;
      white-space: pre-wrap;
    }
  }

  .tl__v {
    color: var(--fg);
  }

  .tl__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: var(--space-2) var(--space-4);
    border-top: var(--hairline) solid var(--border);
  }

  .tl__legend > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tl__key {
    display: inline-block;
    width: 1rem;
    height: 0.5rem;
  }
</style>
