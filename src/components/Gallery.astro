---
// Map screenshots (SPEC §5 Gallery, Stage 7 task 2): every image at the detail preset, the first eager and
// the rest lazy. Each one links to its build-made 1920 px WebP ("view full size", same tab, no lightbox).
// Slideshow (Jay, Stage 7 checkpoint; SPEC D9d): a tiny inline script shows one slide at a time with
// previous / play-pause / next, a counter, arrow keys and a 0.5–5 s duration slider (default 3 s).
// - Crossfade: the new slide fades in on top while the old one stays underneath, then the old one is
//   hidden. Only those two are displayed, so lazy loading still fetches just the current slide and the
//   next one (switched to eager ahead of time). The fade is off under reduced motion (base.css).
// - Autoplay is off under prefers-reduced-motion and holds while the slideshow is hovered or focused.
// - Slides keep a fixed 16:9 frame (a few screenshots are square) so the controls don't jump.
// Without JS the list stays stacked and the controls stay hidden. Comments live here, not in the
// script, to keep the page's JS under the 2 KB gzip cap.
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import { largeUrl } from '../lib/images';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  title: string;
}

const { images, title } = Astro.props;
const items = await Promise.all(images.map(async (image) => ({ ...image, large: await largeUrl(image.src) })));
---

<section class="ss" aria-label={`${title} screenshots`} data-slideshow>
  <ul class="gallery" role="list">
    {
      items.map((image, i) => (
        <li class:list={{ 'is-current': i === 0 }}>
          <a class="shot" href={image.large}>
            <Img src={image.src} alt={image.alt} preset="detail" sizes="(min-width: 80rem) 76rem, 100vw" eager={i === 0} />
            <span class="shot__label">
              view full size <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="ss__bar" hidden>
    <button type="button" class="ss__btn" data-ss="prev" aria-label="Previous screenshot">←</button>
    <button type="button" class="ss__btn ss__play" data-ss="play" aria-label="Pause slideshow">pause</button>
    <button type="button" class="ss__btn" data-ss="next" aria-label="Next screenshot">→</button>
    <div class="ss__speed">
      <span aria-hidden="true">every</span>
      <input type="range" min="0.5" max="5" step="0.5" value="3" aria-label="Seconds per screenshot" />
      <output>3.0 s</output>
    </div>
    <span class="ss__count" aria-live="polite">1 / {items.length}</span>
  </div>
</section>
<script is:inline>
  (function () {
    var g = document.querySelector('[data-slideshow]');
    var s = g && g.querySelectorAll('.gallery > li');
    if (!s || s.length < 2) return;
    var n = s.length, i = 0, hold = false, t, f;
    var q = function (x) { return g.querySelector(x); };
    var c = q('.ss__count'), p = q('.ss__play'), r = q('input'), o = q('output');
    var play = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    var ms = function () { return r.value * 1000; };
    function pre() {
      [1, 2].forEach(function (d) { var m = s[(i + d) % n].querySelector('img'); if (m) m.loading = 'eager'; });
    }
    function show(k) {
      var old = s[i];
      i = (k + n) % n;
      if (old === s[i]) return;
      clearTimeout(f);
      for (var j = 0; j < n; j++) s[j].className = j === i ? 'is-current is-in' : s[j] === old ? 'is-leaving' : '';
      f = setTimeout(function () { old.className = ''; }, 600);
      pre();
      c.textContent = i + 1 + ' / ' + n;
    }
    function timer() {
      clearInterval(t);
      t = setInterval(function () { if (play && !hold) show(i + 1); }, ms());
    }
    function set(on) {
      play = on;
      p.textContent = on ? 'pause' : 'play';
      p.setAttribute('aria-label', (on ? 'Pause' : 'Play') + ' slideshow');
      c.setAttribute('aria-live', on ? 'off' : 'polite');
    }
    function speed() {
      o.textContent = (+r.value).toFixed(1) + ' s';
      r.setAttribute('aria-valuetext', r.value + ' seconds');
      g.style.setProperty('--ss-fade', Math.min(600, ms() * 0.6) + 'ms');
      timer();
    }
    g.classList.add('is-slideshow');
    q('.ss__bar').hidden = false;
    set(play);
    pre();
    speed();
    g.addEventListener('click', function (e) {
      var b = e.target.closest('[data-ss]');
      if (!b) return;
      if (b.dataset.ss === 'play') set(!play);
      else show(i + (b.dataset.ss === 'next' ? 1 : -1));
      timer();
    });
    r.addEventListener('input', speed);
    g.addEventListener('keydown', function (e) {
      if (e.target === r || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
      e.preventDefault();
      show(i + (e.key === 'ArrowRight' ? 1 : -1));
      timer();
    });
    g.addEventListener('mouseenter', function () { hold = true; });
    g.addEventListener('mouseleave', function () { hold = false; });
    g.addEventListener('focusin', function () { hold = true; });
    g.addEventListener('focusout', function () { hold = false; });
  })();
</script>

<style>
  .gallery {
    display: grid;
    gap: var(--space-8);
  }

  /* Slideshow (set by the script): slides share one grid cell; only the current one and, during the
     crossfade, the leaving one are displayed. The current slide fades in on top. */
  .is-slideshow .gallery > li {
    grid-area: 1 / 1;
  }

  .is-slideshow .gallery > li:not(.is-current, .is-leaving) {
    display: none;
  }

  /* Only slides shown by a change fade in (is-in); the first slide appears at once on load. */
  .is-slideshow .gallery > li.is-current {
    z-index: 1;
  }

  .is-slideshow .gallery > li.is-in {
    animation: ss-in var(--ss-fade, 600ms) ease-out;
  }

  @keyframes ss-in {
    from {
      opacity: 0;
    }
  }

  .is-slideshow .shot :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--card);
  }

  .shot {
    display: grid;
    gap: var(--space-2);
    text-decoration: none;
  }

  .shot :global(img) {
    border: var(--hairline) solid var(--border);
  }

  .shot:hover :global(img),
  .shot:focus-visible :global(img) {
    border-color: var(--fg);
  }

  .shot__label {
    justify-self: end;
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  /* The current slide's background covers the leaving one, so its label doesn't show through. */
  .is-slideshow .shot__label {
    background: var(--bg);
  }

  .shot:hover .shot__label,
  .shot:focus-visible .shot__label {
    color: var(--fg);
    text-decoration-line: underline;
  }

  .ss__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .ss__bar[hidden] {
    display: none;
  }

  .ss__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding-inline: var(--space-3);
    border: var(--hairline) solid var(--border);
    font-size: var(--fs-ui);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
  }

  .ss__btn:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  .ss__play {
    min-width: 5.5rem;
  }

  .ss__speed {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap);
    padding-inline: var(--space-3);
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  .ss__speed input {
    width: 7rem;
    accent-color: var(--fg);
    cursor: pointer;
  }

  .ss__speed output {
    min-width: 3.5em;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .ss__count {
    margin-left: auto;
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ss__btn {
      transition:
        border-color var(--duration),
        color var(--duration);
    }
  }
</style>
