---
// Level-design archive (SPEC Stage 7, §4.7; revised Stage 7 with the 43-map master data): secondary
// history. Intro, totals computed from the data (with how the Steam numbers are mapped), the Steam
// Workshop link (the only place it appears), a grayscale ThumbGrid of the 12 old-site maps, then the
// other maps as static text tables grouped by game, newest first. No thumbnails beyond the first 12
// keeps the page inside the budget written for 12 maps (SPEC §6.1).
import Base from '../../../layouts/Base.astro';
import Figure from '../../../components/Figure.astro';
import Button from '../../../components/Button.astro';
import ThumbGrid from '../../../components/ThumbGrid.astro';
import { LEVEL_DESIGN } from '../../../data/pages';
import { SITE } from '../../../site.config';
import { getMaps, totals, fmt, isoDay, type MapEntry } from '../../../lib/levels';

const GRID = 12;
const maps = await getMaps();
const sum = totals(maps);
const href = (m: MapEntry) => `/projects/level-design/${m.id}/`;
const featured = maps.slice(0, GRID).map((m) => ({ title: m.data.title, year: m.data.released.getUTCFullYear(), href: href(m), image: m.data.cover }));

// The rest by game (CS:GO, then CS:Source), newest release first.
const GAMES = ['Counter-Strike: Global Offensive', 'Counter-Strike: Source'];
const rest = maps.slice(GRID);
const groups = [...GAMES, ...new Set(rest.map((m) => m.data.game).filter((g) => !GAMES.includes(g)))]
  .map((game) => ({
    game,
    id: `maps-${game.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
    maps: rest.filter((m) => m.data.game === game).sort((a, b) => b.data.released.getTime() - a.data.released.getTime()),
  }))
  .filter((g) => g.maps.length > 0);
---

<Base
  title="Level design archive · Jay Parekh"
  description={`An archive of the ${sum.maps} custom multiplayer maps Jay Parekh designed for Counter-Strike before software engineering.`}
  current="projects"
>
  <div class="container archive">
    <header class="archive__head">
      <p class="back"><a href="/projects/">← all projects</a></p>
      <h1>~/level-design</h1>
      <p class="intro">{LEVEL_DESIGN.intro}</p>
    </header>

    <section class="archive__stats" aria-label="Totals">
      <div class="stats">
        <Figure value={String(sum.maps)} caption="maps" />
        <Figure value={fmt(sum.downloads)} caption="downloads" />
        <Figure value={fmt(sum.views)} caption="views" />
      </div>
      <p class="note">
        As of <time datetime={LEVEL_DESIGN.statsAsOf}>{LEVEL_DESIGN.statsAsOf}</time>. {LEVEL_DESIGN.statsNote}
      </p>
      {SITE.links.steamWorkshop && <Button href={SITE.links.steamWorkshop}>Steam Workshop</Button>}
    </section>

    <section aria-labelledby="maps">
      <h2 id="maps" class="label maps__head">{GRID} featured maps</h2>
      <ThumbGrid items={featured} label="Featured maps" />
    </section>

    <section class="more" aria-labelledby="more">
      <h2 id="more" class="label maps__head">{rest.length} more maps</h2>
      {
        groups.map((g) => (
          <div class="group">
            <h3 id={g.id} class="group__title">
              {g.game} <span class="muted">({g.maps.length})</span>
            </h3>
            <section class="table-wrap" aria-labelledby={g.id} tabindex="0">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Map</th>
                    <th scope="col">Released</th>
                    <th scope="col" class="num">Downloads</th>
                    <th scope="col" class="num">Views</th>
                  </tr>
                </thead>
                <tbody>
                  {g.maps.map((m) => (
                    <tr>
                      <th scope="row">
                        <a href={href(m)}>{m.data.title}</a>
                      </th>
                      <td>
                        <time datetime={isoDay(m.data.released)}>{isoDay(m.data.released)}</time>
                      </td>
                      <td class="num">{fmt(m.data.downloads)}</td>
                      <td class="num">{fmt(m.data.views)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .archive {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-section);
  }

  .archive__head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--prose);
  }

  .back {
    font-size: var(--fs-ui);
  }

  .back a {
    color: var(--muted);
    text-decoration-line: underline;
    text-underline-offset: 3px;
  }

  h1 {
    font-size: var(--fs-title);
  }

  .archive__stats {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .stats {
    display: grid;
    width: 100%;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .note {
    max-width: var(--prose);
    margin-bottom: var(--space-2);
    font-size: var(--fs-ui);
    color: var(--muted);
  }

  .maps__head {
    margin-bottom: var(--space-4);
  }

  .more {
    display: grid;
    gap: var(--space-8);
  }

  .more .maps__head {
    margin-bottom: 0;
  }

  /* min-width: 0 lets a grid item shrink below its table, so the table scrolls in its box instead. */
  .group {
    min-width: 0;
  }

  .group__title {
    margin-bottom: var(--space-3);
    font-size: var(--fs-body);
  }

  /* Wide tables scroll inside their box on narrow screens; the page itself never scrolls sideways. */
  .table-wrap {
    overflow-x: auto;
    border: var(--hairline) solid var(--border);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-ui);
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.625rem var(--space-4);
    text-align: left;
    white-space: nowrap;
  }

  thead th {
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
    border-bottom: var(--hairline) solid var(--border);
  }

  tbody tr + tr {
    border-top: var(--hairline) solid var(--border);
  }

  tbody tr:hover {
    background: var(--card);
  }

  tbody th {
    font-weight: 700;
  }

  tbody th a {
    text-decoration-line: underline;
    text-underline-offset: 3px;
  }

  .num {
    text-align: right;
  }
</style>
