---
// Level-design archive (SPEC Stage 7, §4.7; revised Stage 7 with the master data): secondary history.
// Intro, totals and per-game map counts computed from the data, the Steam Workshop and GameBanana links
// (the only place they appear), then two sections, each with a CSS-only grid / list switch (ViewSwitch,
// grid by default; Jay, Stage 7 checkpoint):
// - featured maps (the 12 old-site maps + extra maps such as the unreleased awp_taj_mahal): large
//   cards, or the list table;
// - the other maps: small cards grouped by game (CS:GO, then CS:Source), or the list table.
// Both sections sort by views, most first (Jay); unreleased maps have none, so they come last.
// Every thumbnail is the 400 px image (ThumbGrid), so the page stays inside its 450 KB total budget.
import Base from '../../../layouts/Base.astro';
import Figure from '../../../components/Figure.astro';
import Button from '../../../components/Button.astro';
import ThumbGrid from '../../../components/ThumbGrid.astro';
import ViewSwitch from '../../../components/ViewSwitch.astro';
import MapTable from '../../../components/MapTable.astro';
import { LEVEL_DESIGN } from '../../../data/pages';
import { SITE } from '../../../site.config';
import { getMaps, totals, fmt, type MapEntry } from '../../../lib/levels';

const maps = await getMaps();
const sum = totals(maps);
const card = (m: MapEntry) => ({ title: m.data.title, year: m.data.released.getUTCFullYear(), href: `/projects/level-design/${m.id}/`, image: m.data.cover });
// Most viewed first; the archive order (m.data.order) still drives prev/next on map pages.
const byViews = (a: MapEntry, b: MapEntry) => (b.data.views ?? -1) - (a.data.views ?? -1);
const featured = maps.filter((m) => m.data.featured).sort(byViews);

// The rest, split by game (CS:GO, then CS:Source) in grid view.
const GAMES = ['Counter-Strike: Global Offensive', 'Counter-Strike: Source'];
const SHORT: Record<string, string> = { 'Counter-Strike: Global Offensive': 'CS:GO', 'Counter-Strike: Source': 'CS:Source' };
const rest = maps.filter((m) => !m.data.featured).sort(byViews);
const perGame = GAMES.map((game) => ({ game, count: maps.filter((m) => m.data.game === game).length }));
const groups = GAMES.map((game) => ({ game, maps: rest.filter((m) => m.data.game === game) })).filter((g) => g.maps.length > 0);
---

<Base
  title="Level design archive · Jay Parekh"
  description={`An archive of the ${sum.maps} custom multiplayer maps Jay Parekh designed for Counter-Strike before software engineering.`}
  current="projects"
>
  <div class="container archive">
    <header class="archive__head">
      <p class="back"><a href="/projects/">← all projects</a></p>
      <h1>~/level-design</h1>
      <p class="intro">{LEVEL_DESIGN.intro}</p>
    </header>

    <section class="archive__stats" aria-label="Totals">
      <div class="stats">
        <Figure value={String(sum.maps)} caption="maps" />
        <Figure value={fmt(sum.downloads)} caption="downloads" />
        <Figure value={fmt(sum.views)} caption="views" />
        {perGame.map((g) => <Figure value={String(g.count)} caption={`${SHORT[g.game] ?? g.game} maps`} />)}
      </div>
      <div class="links">
        {SITE.links.steamWorkshop && <Button href={SITE.links.steamWorkshop}>Steam Workshop</Button>}
        {SITE.links.gamebanana && <Button href={SITE.links.gamebanana}>GameBanana Submissions</Button>}
      </div>
    </section>

    <section class="maps" aria-labelledby="featured">
      <h2 id="featured" class="label maps__head">{featured.length} featured maps</h2>
      <ViewSwitch name="view-featured" label="featured maps" />
      <div class="view view--grid">
        <ThumbGrid items={featured.map(card)} label="Featured maps" />
      </div>
      <div class="view view--list">
        <MapTable maps={featured} label="Featured maps" />
      </div>
    </section>

    <section class="maps" aria-labelledby="more">
      <h2 id="more" class="label maps__head">{rest.length} more maps</h2>
      <ViewSwitch name="view-more" label="more maps" />
      <div class="view view--grid">
        {
          groups.map((g) => (
            <div class="group">
              <h3 class="group__title">
                {g.game} <span class="muted">({g.maps.length})</span>
              </h3>
              <ThumbGrid items={g.maps.map(card)} label={`${g.game} maps`} size="sm" />
            </div>
          ))
        }
      </div>
      <div class="view view--list">
        <MapTable maps={rest} label="More maps" />
      </div>
    </section>
  </div>
</Base>

<style>
  .archive {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-section);
  }

  .archive__head {
    display: grid;
    gap: var(--space-4);
    max-width: var(--prose);
  }

  .back {
    font-size: var(--fs-ui);
  }

  .back a {
    color: var(--muted);
    text-decoration-line: underline;
    text-underline-offset: 3px;
  }

  h1 {
    font-size: var(--fs-title);
  }

  .archive__stats {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .stats {
    display: grid;
    width: 100%;
    gap: var(--space-3);
  }

  /* Totals on the first row (3 across), the per-game counts on the second (2 across). */
  @media (min-width: 48rem) {
    .stats {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .stats > :global(*) {
      grid-column: span 2;
    }

    .stats > :global(:nth-child(n + 4)) {
      grid-column: span 3;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  /* min-width: 0 lets these shrink below a wide table, so the table scrolls in its box instead. */
  .maps,
  .view,
  .group {
    min-width: 0;
  }

  .maps__head {
    margin-bottom: var(--space-4);
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--fg);
  }

  .group + .group {
    margin-top: var(--space-8);
  }

  .group__title {
    margin-bottom: var(--space-3);
    font-size: var(--fs-body);
  }
</style>
