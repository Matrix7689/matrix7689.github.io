---
// Home page (SPEC Stage 4, §4.1). For now it shows everything (Jay, Stage 4 checkpoint); a compact
// version with "view more" toggles comes later. Order: intro → 01 about → 02 highlights → 03 experience
// → 04 education → 05 blog → 06 projects → 07 skills.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import CommandBlock from '../components/CommandBlock.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SpecTable from '../components/SpecTable.astro';
import CompactToggle from '../components/CompactToggle.astro';
import SectionRail from '../components/SectionRail.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Figure from '../components/Figure.astro';
import PostListItem from '../components/PostListItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { SITE } from '../site.config';
import { HOME, ABOUT, CREDENTIALS } from '../data/pages';
import { getPosts, postSlug } from '../lib/posts';
import { buildTimeline, type Segment } from '../lib/timeline';

const site = Astro.site!.origin;

// The terminal's ls output: site sections, then profiles (Jay, Stage 5 checkpoint).
const terminalLinks = [
  { label: 'blog/', href: '/blog/' },
  { label: 'projects/', href: '/projects/' },
  { label: 'github', href: SITE.links.github },
  { label: 'linkedin', href: SITE.links.linkedin },
  { label: 'medium', href: SITE.links.medium },
  { label: 'email', href: `mailto:${SITE.email}` },
].filter((l): l is { label: string; href: string } => l.href !== null);

const roles = (await getCollection('experience', (r) => r.data.showOnHome)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getPosts()).slice(0, 5);
const projects = (await getCollection('projects', (p) => p.data.featured)).sort((a, b) => a.data.order - b.data.order);

// Vertical "on this page" rail (Jay, Stage 5 checkpoint); ids match the SectionHeaders below.
// 00 is back to the top (#top is on <body>, see Base).
const sections = [
  { n: '00', id: 'top', name: 'top' },
  ...['about', 'highlights', 'experience', 'education', 'blog', 'projects', 'skills'].map((id, i) => ({
    n: String(i + 1).padStart(2, '0'),
    id,
    name: `~/${id}`,
  })),
];

// Timeline bars from the roles and university entries (HOME.timeline lists the lanes, in order).
const segments: Segment[] = [
  ...roles.map(({ data: r }) => ({ title: r.title, org: r.company, start: r.start, end: r.end, kind: /intern/i.test(r.title) ? ('internship' as const) : ('work' as const) })),
  ...ABOUT.education.filter((e) => e.level === 'university').map((e) => ({ title: e.degree, org: e.school, start: e.start, end: e.end, kind: 'study' as const })),
];
const timeline = buildTimeline(
  HOME.timeline.from,
  HOME.timeline.lanes.map((l) => ({ label: l.label, segments: segments.filter((s) => s.org === l.org) })),
);

// Education reads like experience (Jay, Stage 5 checkpoint): degree as the title, one coursework sentence.
const courses = new Intl.ListFormat('en', { type: 'conjunction' });
const coursework = (list: string[]) => `Coursework included ${courses.format(list)}.`;

// JSON-LD Person (Stage 4 task 5). sameAs = every non-null profile link.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: `${site}/`,
  jobTitle: 'Software Development Engineer II',
  worksFor: { '@type': 'Organization', name: 'Amazon' },
  alumniOf: ABOUT.education.filter((e) => e.level === 'university').map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsLanguage: CREDENTIALS.languages.map((l) => l.name),
  sameAs: Object.values(SITE.links).filter((l): l is string => l !== null),
};
---

<Base title="Jay Parekh · Software Engineer" description="Portfolio and blog of Jay Parekh, software engineer." current="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  {/* Career timeline bar positions (lib/timeline.ts); inline style attributes are not allowed. */}
  <Fragment slot="head"><style is:inline set:html={timeline.css} /></Fragment>
  <SectionRail sections={sections} />

  <section class="container intro" aria-labelledby="intro-title">
    <div class="intro__head">
      <h1 id="intro-title">{SITE.name}</h1>
      <ul class="intro__tags" role="list" aria-label="About me">
        {
          HOME.tags.map((t) => (
            <li>
              <Tag label={t} />
            </li>
          ))
        }
      </ul>
    </div>
    <div class="intro__text">
      <p class="intro__line">{HOME.oneLiner}</p>
    </div>
    <div class="intro__term">
      <CommandBlock
        id="home-cmd"
        title="jay@portfolio ~ terminal"
        variant="inverted"
        command={`curl -sLO ${site}${SITE.resume}`}
        outputLinks={terminalLinks}
      />
      <div class="intro__cta">
        <Button href={SITE.resume} newTab>Preview resume</Button>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="about">
    <div class="container">
      <SectionHeader number="01" title="~/about" id="about" />
      <div class="prose summary">
        {ABOUT.summary.map((p) => <p>{p}</p>)}
      </div>
      <div class="about-more">
        <Button href="/about/" variant="secondary">more about me</Button>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="highlights">
    <div class="container">
      <SectionHeader number="02" title="~/highlights" id="highlights" />
      <div class="stack-lg">
        {
          HOME.highlights.map((g) => (
            <div>
              <h3 class="label group">{g.group}</h3>
              <div class="figs">
                {g.items.map((h) => (
                  <Figure value={h.value} caption={h.caption} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="experience">
    <div class="container">
      <SectionHeader number="03" title="~/experience" id="experience" />
      <CompactToggle id="compact-experience" label="experience" />
      <CareerTimeline timeline={timeline} />
      <div class="stack-lg">
        {
          roles.map(({ data: r }) => (
            <ExperienceItem company={r.company} title={r.title} start={r.start} end={r.end} location={r.location} bullets={r.bullets} limit={r.homeBulletLimit} compact={r.compactBullets} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="education">
    <div class="container">
      <SectionHeader number="04" title="~/education" id="education" />
      <div class="stack-lg">
        {
          ABOUT.education.map((e) => (
            <ExperienceItem company={e.school} title={e.degree} start={e.start} end={e.end} location={e.location} bullets={[coursework(e.coursework)]} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="blog">
    <div class="container">
      <SectionHeader number="05" title="~/blog" id="blog" />
      {
        posts.length > 0 ? (
          <div class="posts">
            {posts.map((p) => (
              <PostListItem
                date={p.data.date}
                tags={p.data.tags}
                title={p.data.title}
                summary={p.data.summary}
                href={`/blog/${postSlug(p)}/`}
                medium={p.data.mediumUrl !== undefined}
              />
            ))}
          </div>
        ) : (
          <EmptyState command="ls blog/" message="0 posts — first one is on the way. Subscribe:" link={{ label: 'rss.xml', href: '/rss.xml' }} />
        )
      }
      <p class="more"><a href="/blog/">all posts →</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="projects">
    <div class="container">
      <SectionHeader number="06" title="~/projects" id="projects" />
      <div class="cards">
        {
          projects.map((p) => (
            <ProjectCard title={p.data.title} summary={p.data.summary} stack={p.data.stack} year={p.data.year} href={`/projects/${p.id}/`} thumb={p.data.cover} />
          ))
        }
      </div>
      <p class="more"><a href="/projects/">all projects →</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="skills">
    <div class="container">
      <SectionHeader number="07" title="~/skills" id="skills" />
      <SpecTable label="Skills" size="lg" rows={HOME.skillGroups.map((g) => ({ label: g.label, value: g.items.join(', ') }))} />
    </div>
  </section>
</Base>

<style>
  /* One column at every width: name + tags, the one-liner, then the terminal across the full
     container width (Jay, Stage 5 checkpoint). */
  .intro {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-section);
  }

  .intro__head,
  .intro__text {
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  h1 {
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .intro__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .intro__line {
    max-width: 60ch;
  }

  .intro__cta {
    margin-top: var(--space-6);
  }

  /* Room on the right for the fixed SectionRail; from 88rem the centred container's margin is enough. */
  @media (min-width: 64rem) and (max-width: 88rem) {
    .container {
      padding-right: calc(var(--gutter) + 3rem);
    }
  }

  .band {
    padding-block: var(--space-section);
    border-top: var(--hairline) solid var(--border);
  }

  .summary {
    display: grid;
    gap: var(--space-4);
  }

  .about-more {
    margin-top: var(--space-8);
  }

  .stack-lg {
    display: grid;
    gap: var(--space-12);
  }

  .more {
    margin-top: var(--space-8);
    font-size: var(--fs-ui);
  }

  .more a {
    color: var(--muted);
  }

  .more a:hover,
  .more a:focus-visible {
    color: var(--fg);
    text-decoration-line: underline;
  }

  /* Highlight group titles, larger than the micro label style (Jay, Stage 5 checkpoint). */
  .group {
    margin-bottom: var(--space-4);
    font-size: var(--fs-body-lg);
    font-weight: 700;
    color: var(--fg);
  }

  /* Two columns on phones, up to five on wide screens; values shrink to fit narrow cells. */
  .figs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .figs {
      grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
      gap: var(--space-4);
    }
  }

  .figs :global(.stat) {
    padding: var(--space-4) var(--space-3);
  }

  .figs :global(.stat__value) {
    font-size: clamp(1.125rem, 0.85rem + 1.4vw, 1.75rem);
    overflow-wrap: anywhere;
  }

  .posts {
    display: grid;
    gap: var(--space-2);
  }

  .cards {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
