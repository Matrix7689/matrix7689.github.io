---
// Blog index (SPEC Stage 5 task 1, §4.3; simplified by Jay after Stage 8): tag filter and every post, newest
// first, or the empty state at 0 posts.
import Base from '../../layouts/Base.astro';
import TagFilter from '../../components/TagFilter.astro';
import PostList from '../../components/PostList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { BLOG_INDEX } from '../../data/pages';
import { getPosts, tagsOf } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog · Jay Parekh" description="Posts by Jay Parekh on software engineering." current="blog">
  <div class="container blog">
    <header class="blog__head">
      <h1>~/blog</h1>
      {BLOG_INDEX.subtitle && <p class="muted">{BLOG_INDEX.subtitle}</p>}
    </header>

    {
      posts.length > 0 ? (
        <>
          <TagFilter tags={tagsOf(posts)} active={null} />
          <PostList posts={posts} />
        </>
      ) : (
        <EmptyState command="ls blog/" message="0 posts — first one is on the way. Subscribe:" link={{ label: 'rss.xml', href: '/rss.xml' }} />
      )
    }
  </div>
</Base>

<style>
  .blog {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-12) var(--space-section);
  }

  .blog__head {
    display: grid;
    gap: var(--space-2);
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: var(--lh-tight);
    letter-spacing: -0.03em;
  }
</style>
