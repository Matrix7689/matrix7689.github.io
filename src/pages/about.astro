---
// About (SPEC Stage 8, §4.6; Stage 8 checkpoint): only Jay's own text and his photo. The text is
// ABOUT.story (**bold** marks key facts), with the years filled in at build time from CAREER. Each heading can carry
// monochrome logos (SectionLogos). The experience, education, elsewhere and resume blocks were removed
// at Jay's request; the resume stays on the home page and in the footer.
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import SectionLogos from '../components/SectionLogos.astro';
import { ABOUT, CAREER, yearsSince } from '../data/pages';
import { inlineMarkdown } from '../lib/inline';

const fill = (p: string) =>
  p.replace('{years}', String(yearsSince(CAREER.programmingSince))).replace('{proYears}', numberWord(yearsSince(CAREER.professionalSince)));
// Jay writes small counts as words ("five of them professionally").
function numberWord(n: number) {
  return ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'][n] ?? String(n);
}
const story = ABOUT.story.map((s) => ({ ...s, paragraphs: s.paragraphs.map(fill) }));

// Photo width: 13rem beside the text from 64rem, 12rem above it below that (see .about__photo).
const HEADSHOT_SIZES = '(min-width: 64rem) 13rem, 12rem';
---

<Base title="About · Jay Parekh" description="About Jay Parekh: software engineer on Amazon's Shopping Cart team, and before that a Counter-Strike level designer." current="about">
  <div class="container about">
    <article class="about__text">
      <h1>~/about</h1>
      {
        story.map((s) => (
          <section class="part" aria-label={s.heading ?? 'Introduction'}>
            {s.heading && (
              <h2 class="part__head">
                <span>{s.heading}</span>
                <SectionLogos names={s.logos} />
              </h2>
            )}
            {s.paragraphs.map((p) => (
              <p set:html={inlineMarkdown(p)} />
            ))}
          </section>
        ))
      }
    </article>
    <div class="about__photo">
      <Headshot sizes={HEADSHOT_SIZES} />
    </div>
  </div>
</Base>

<style>
  /* Text on the left at reading width, the photo on the right (sticky) from 64rem; above the text below. */
  .about {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-section);
  }

  .about__text {
    display: grid;
    gap: var(--space-12);
    max-width: var(--prose);
  }

  h1 {
    font-size: var(--fs-title);
    margin-bottom: calc(-1 * var(--space-6));
  }

  .part {
    display: grid;
    gap: var(--space-4);
  }

  .part__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--fs-title);
  }

  .about__photo {
    order: -1;
    width: 12rem;
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: minmax(0, var(--prose)) 13rem;
      justify-content: start;
      gap: var(--space-12);
      align-items: start;
    }

    .about__photo {
      order: 0;
      width: 13rem;
      position: sticky;
      top: calc(3.5rem + var(--space-8));
    }
  }
</style>
