{
  "$comment": "SPEC §6.1: mobile preset (Lighthouse default), 3 runs, median. LHCI serves the existing dist/ itself (run a build first); it replaces the host and port in each URL. Later stages add their URLs. /404.html is noindex (Stage 8 task 2), which Lighthouse always fails as 'is-crawlable', so for that URL the SEO category is asserted audit by audit instead, with is-crawlable off (Stage 8 deviation).",
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/", "http://localhost/blog/", "http://localhost/blog/critical-thinking-is-fading-heres-how-you-can-reclaim-it/", "http://localhost/projects/", "http://localhost/projects/halma-ai/", "http://localhost/projects/level-design/", "http://localhost/projects/level-design/awp-lego-asia/", "http://localhost/projects/level-design/lcz-ctf-galaxy/", "http://localhost/projects/level-design/aim-lego-ak/", "http://localhost/projects/level-design/awp-taj-mahal/", "http://localhost/about/", "http://localhost/404.html"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["error", { "maxNumericValue": 50, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "categories:best-practices": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
            "document-title": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "meta-description": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "http-status-code": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "link-text": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "crawlable-anchors": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "hreflang": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "canonical": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["error", { "maxNumericValue": 50, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
