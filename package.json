{
  "name": "matrix7689.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "astro check && astro build && npm run check:budgets && npm run check:originals && npm run check:html && npm run check:links",
    "build:fixtures": "cross-env INCLUDE_FIXTURES=1 SHOW_DRAFTS=1 astro build",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:originals": "node scripts/check-originals.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "check:inputs": "node scripts/check-inputs.mjs",
    "lhci": "lhci autorun",
    "new:post": "node scripts/new-post.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "icons": "node scripts/favicons.mjs",
    "media:gifs": "node scripts/convert-gifs.mjs",
    "inventory": "node scripts/inventory.mjs",
    "repo:size": "node scripts/repo-size.mjs",
    "import:levels": "node scripts/import-levels.mjs",
    "media:frames": "node scripts/extract-frames.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/rss": "4.0.19",
    "@lhci/cli": "0.15.1",
    "@types/node": "24.19.2",
    "astro": "7.4.7",
    "cross-env": "10.1.0",
    "ffmpeg-static": "5.3.0",
    "geist": "1.9.0",
    "html-validate": "11.17.0",
    "linkinator": "8.1.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "6.0.3"
  }
}
